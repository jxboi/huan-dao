# Optional: cloud sync + "Continue with Facebook" (Supabase Auth). Leave unset for a local-only app.
# On Vercel, the Supabase Marketplace integration provisions NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY (or ..._PUBLISHABLE_KEY) automatically — those work too.
# Only ever use the anon/publishable key here: it ships to the browser. Never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
